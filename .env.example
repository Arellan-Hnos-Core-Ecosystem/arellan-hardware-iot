# ============================================================
# Arellan Hardware IoT Bridge — Environment Configuration
# ============================================================

# ─── Entorno ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3007

# ─── Backend unificado (arellan-platform) ─────────────────────
PLATFORM_API_URL=http://localhost:3001/api/v1
# Debe coincidir con IOT_BRIDGE_SHARED_SECRET de arellan-platform/.env
# (header x-device-key en ambas direcciones)
IOT_BRIDGE_SHARED_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars

# ─── ZKTeco ADMS (FASE 1: biometria de asistencia) ─────────────
# Seriales de dispositivos autorizados a hacer POST /adms/attendance
ZKTECO_DEVICE_SN_WHITELIST=ZKTECO123456,ZKTECO789012

# ─── Camaras ONVIF (FASE 2: control multimedia de check-in) ────
# JSON con las camaras IP de la zona de check-in.
# position se usa como sugerencia para arellan-platform (FRONT|BACK|LEFT|RIGHT|DASHBOARD)
ONVIF_CAMERAS=[{"cameraId":"CAM-BAHIA-01","host":"192.168.1.50","port":80,"user":"admin","pass":"changeme","position":"FRONT"}]
